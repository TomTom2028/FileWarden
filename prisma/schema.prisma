// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum FilecheckResultValue {
  PASS
  FAIL
  UNKNOWN

  @@map("filecheck_result_value")
}

model CachedResult {
  id        Int                  @id @default(autoincrement())
  hash      Bytes                @unique
  result    FilecheckResultValue
  firstSeen DateTime             @default(now()) @map("first_seen")
  history   FilecheckResult[]

  @@index([hash])
  @@map("cached_result")
}

model FilecheckResult {
  id        Int          @id @default(autoincrement())
  fileId    Int          @map("file_id")
  timestamp DateTime     @default(now())
  hashId    Int          @map("hash_id")
  cached    CachedResult @relation(fields: [hashId], references: [id])
  file      File         @relation(fields: [fileId], references: [id])

  @@map("filecheck_result")
}

model File {
  id      Int               @id @default(autoincrement())
  path    String            @unique
  results FilecheckResult[]

  @@map("file")
}
